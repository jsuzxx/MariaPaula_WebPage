---
// Layout maestro: encabezado SEO, metadatos sociales, favicon y datos estructurados.
// Todo lo que se repite entre páginas vive aquí.
import '../styles/global.css';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = '/img/og-default.jpg',
  ogType = 'website',
  publishedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

// Datos estructurados base: ficha de negocio legal (aparece en resultados de Google)
const legalServiceLd = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: SITE.fullName,
  description: SITE.description,
  url: SITE.url,
  image: ogImageUrl,
  telephone: `+${SITE.phoneIntl}`,
  email: SITE.email,
  address: { '@type': 'PostalAddress', addressCountry: SITE.country_code },
  areaServed: { '@type': 'Country', name: SITE.country },
  availableLanguage: 'Spanish',
  priceRange: '$$',
};

const jsonLdBlocks = [
  legalServiceLd,
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <meta name="robots" content="index, follow, max-image-preview:large" />
      )
    }
    <meta name="author" content={SITE.fullName} />
    <meta name="theme-color" content="#08172E" />
    <meta name="format-detection" content="telephone=yes" />

    <!-- Favicon e iconos -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Tipografía -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Metadatos para compartir en redes y WhatsApp (Open Graph) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:locale" content={SITE.locale.replace('_', '-')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={SITE.fullName} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Datos estructurados JSON-LD (SEO semántico) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBlocks)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <slot />
    <script>
      // Animación de aparición al hacer scroll (elementos .rv)
      const obs = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('on');
              obs.unobserve(e.target);
            }
          }),
        { threshold: 0.1 }
      );
      document.querySelectorAll('.rv').forEach((el) => obs.observe(el));
      document.querySelectorAll('#inicio .rv, .page-hero .rv').forEach((el) => el.classList.add('on'));
    </script>
  </body>
</html>
