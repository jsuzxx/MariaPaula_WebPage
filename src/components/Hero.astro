---
// Sección Hero: presentación principal con CTA de WhatsApp y foto.
import { Image } from 'astro:assets';
import foto from '../assets/foto-mariapaula.jpg';
import { WA_DEFAULT } from '../data/site';
---

<section id="inicio" aria-label="Presentación principal">
  <div class="h-dots" aria-hidden="true"></div>
  <div class="h-g1" aria-hidden="true"></div>
  <div class="h-g2" aria-hidden="true"></div>
  <div class="h-line" aria-hidden="true"></div>
  <div class="container">
    <div class="h-layout">
      <div>
        <div class="h-eyebrow rv">
          <div class="h-eline"></div><span>Abogada Profesional · Colombia</span>
        </div>
        <h1 class="h-title rv d1">
          <em>El derecho</em><br />a su lado,<br /><span class="nb">cuando más lo necesita.</span>
        </h1>
        <p class="h-sub rv d2">
          Soy Maria Paula Ramírez, abogada con vocación de servicio. Le acompaño en cada paso de
          su proceso legal con claridad, compromiso y dedicación.
        </p>
        <div class="h-actions rv d3">
          <a href={WA_DEFAULT} class="btn btn-gold" target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.533 5.853L.06 23.4l5.7-1.453A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.001-1.368l-.359-.213-3.384.863.9-3.296-.234-.379A9.818 9.818 0 1112 21.818z"/></svg>
            Solicitar asesoría
          </a>
          <a href="#servicios" class="btn btn-ghost">Ver servicios →</a>
        </div>
        <div class="h-stats rv d4">
          <div><div class="h-snum">4</div><div class="h-slbl">Servicios jurídicos</div></div>
          <div><div class="h-snum">100%</div><div class="h-slbl">Compromiso</div></div>
          <div><div class="h-snum">Col</div><div class="h-slbl">Cobertura nacional</div></div>
        </div>
      </div>
      <div class="h-photo rv d2">
        <div class="h-frame">
          <Image
            src={foto}
            alt="Abogada Maria Paula Ramírez"
            class="h-img"
            width={680}
            loading="eager"
            fetchpriority="high"
          />
          <div class="h-badge" aria-hidden="true">
            <div class="h-bdot"></div>
            <div class="h-btxt">Disponible ahora<small>Respuesta por WhatsApp</small></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="h-scroll" aria-hidden="true"><div class="h-sline"></div><span class="h-stxt">Scroll</span></div>
</section>

<style>
  #inicio { min-height:100vh;background:var(--navy);display:flex;align-items:center;position:relative;overflow:hidden;padding:7rem 0 4rem; }
  .h-dots { position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.04) 1px,transparent 1px);background-size:36px 36px;pointer-events:none; }
  .h-g1 { position:absolute;top:-100px;right:-100px;width:600px;height:600px;background:radial-gradient(circle,rgba(61,111,212,.22) 0%,transparent 65%);pointer-events:none; }
  .h-g2 { position:absolute;bottom:-150px;left:-100px;width:500px;height:500px;background:radial-gradient(circle,rgba(201,169,110,.1) 0%,transparent 65%);pointer-events:none; }
  .h-line { position:absolute;top:0;right:28%;width:1px;height:100%;background:linear-gradient(to bottom,transparent,rgba(201,169,110,.18) 30%,rgba(201,169,110,.18) 70%,transparent);pointer-events:none; }
  .h-layout { position:relative;z-index:2;display:grid;grid-template-columns:1.1fr .9fr;gap:4rem;align-items:center; }
  .h-eyebrow { display:flex;align-items:center;gap:1rem;margin-bottom:2rem; }
  .h-eline { width:40px;height:1px;background:var(--gold); }
  .h-eyebrow span { font-size:.7rem;font-weight:600;letter-spacing:.25em;text-transform:uppercase;color:var(--gold); }
  .h-title { font-family:var(--fd);font-size:clamp(2.8rem,5.5vw,5rem);color:var(--white);line-height:1.1;font-weight:400;margin-bottom:1.5rem; }
  .h-title :global(em) { font-style:italic;color:var(--gold); }
  .h-title :global(.nb) { display:block;font-weight:700;letter-spacing:-.02em; }
  .h-sub { font-size:1.05rem;color:rgba(255,255,255,.55);line-height:1.75;max-width:480px;margin-bottom:2.8rem; }
  .h-actions { display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:3.5rem; }
  .h-stats { display:flex;gap:2.5rem;padding-top:2.5rem;border-top:1px solid rgba(255,255,255,.07); }
  .h-snum { font-family:var(--fd);font-size:2rem;color:var(--white);font-weight:400;line-height:1; }
  .h-slbl { font-size:.7rem;color:rgba(255,255,255,.4);letter-spacing:.08em;text-transform:uppercase;margin-top:.3rem; }
  .h-photo { position:relative;display:flex;justify-content:center; }
  .h-frame { position:relative;width:340px; }
  .h-frame::before { content:'';position:absolute;top:-16px;right:-16px;width:100%;height:100%;border:1px solid rgba(201,169,110,.3);border-radius:var(--rxl);z-index:0; }
  .h-frame::after  { content:'';position:absolute;bottom:-24px;left:-24px;width:80px;height:80px;border-bottom:2px solid var(--gold);border-left:2px solid var(--gold);z-index:0; }
  .h-img { position:relative;z-index:1;width:100%;height:auto;display:block;border-radius:var(--rxl); }
  .h-badge { position:absolute;bottom:2rem;left:-2rem;background:rgba(255,255,255,.06);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.12);border-radius:var(--rl);padding:1.1rem 1.4rem;display:flex;align-items:center;gap:1rem;z-index:2;animation:fbadge 4s ease-in-out infinite; }
  @keyframes fbadge{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  .h-bdot { width:10px;height:10px;background:#25D366;border-radius:50%;box-shadow:0 0 0 4px rgba(37,211,102,.2);flex-shrink:0;animation:pg 2s ease-in-out infinite; }
  @keyframes pg{0%,100%{box-shadow:0 0 0 4px rgba(37,211,102,.2)}50%{box-shadow:0 0 0 8px rgba(37,211,102,.08)}}
  .h-btxt { font-size:.78rem;color:rgba(255,255,255,.8);font-weight:500;line-height:1.3; }
  .h-btxt :global(small) { display:block;font-size:.65rem;color:rgba(255,255,255,.35);font-weight:400; }
  .h-scroll { position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;z-index:2; }
  .h-sline { width:1px;height:50px;background:linear-gradient(to bottom,rgba(201,169,110,.6),transparent);animation:sl 2s ease-in-out infinite; }
  @keyframes sl{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
  .h-stxt { font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.2); }

  @media (max-width: 900px) {
    .h-layout { grid-template-columns: 1fr; }
    .h-photo { display: none; }
  }
</style>
