---
// Sección de contacto: canales directos (WhatsApp y correo).
import { SITE, WA_DEFAULT } from '../data/site';
---

<section id="contacto" aria-label="Información de contacto">
  <div class="ct-bg" aria-hidden="true">JUS</div>
  <div class="ct-glow" aria-hidden="true"></div>
  <div class="container ct-layout">
    <div class="ct-text">
      <div class="eyebrow rv" style="margin-bottom:1.5rem">
        <div class="eline" style="background:rgba(201,169,110,.6)"></div>
        <span class="etxt" style="color:rgba(201,169,110,.7)">Contacto</span>
      </div>
      <h2 class="rv d1">¿Tiene una situación legal?<br /><em>Hablemos.</em></h2>
      <p class="rv d2">
        Estoy disponible para atender su caso con la seriedad y el compromiso que merece.
        Escríbame por WhatsApp y le responderé a la brevedad.
      </p>
    </div>
    <div class="ct-right">
      <a href={WA_DEFAULT} class="ct-ch rv d2" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
        <div class="ct-ico ct-ico-wa"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.533 5.853L.06 23.4l5.7-1.453A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.001-1.368l-.359-.213-3.384.863.9-3.296-.234-.379A9.818 9.818 0 1112 21.818z"/></svg></div>
        <div><div class="ct-lbl">WhatsApp (canal principal)</div><div class="ct-val">{SITE.phoneDisplay}</div></div>
      </a>
      <a href={`mailto:${SITE.email}`} class="ct-ch rv d3" aria-label="Correo electrónico">
        <div class="ct-ico ct-ico-mail"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg></div>
        <div><div class="ct-lbl">Correo electrónico</div><div class="ct-val">{SITE.email}</div></div>
      </a>
      <div class="ct-ctas rv d4">
        <a href={WA_DEFAULT} class="btn btn-wa" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.533 5.853L.06 23.4l5.7-1.453A11.944 11.944 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.001-1.368l-.359-.213-3.384.863.9-3.296-.234-.379A9.818 9.818 0 1112 21.818z"/></svg>
          Iniciar conversación en WhatsApp
        </a>
        <a href={`mailto:${SITE.email}`} class="btn btn-ghost">Enviar correo</a>
      </div>
    </div>
  </div>
</section>

<style>
  #contacto { padding:7rem 0;background:var(--navy);position:relative;overflow:hidden; }
  .ct-bg { position:absolute;bottom:-3rem;right:-1rem;font-family:var(--fd);font-size:18rem;font-weight:700;color:rgba(255,255,255,.02);letter-spacing:-.05em;user-select:none;pointer-events:none;line-height:1; }
  .ct-glow { position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:700px;height:400px;background:radial-gradient(ellipse,rgba(61,111,212,.15) 0%,transparent 65%);pointer-events:none; }
  .ct-layout { position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center; }
  .ct-text h2 { font-family:var(--fd);font-size:clamp(2rem,4vw,3.2rem);color:var(--white);font-weight:400;line-height:1.2;margin-bottom:1.2rem; }
  .ct-text h2 :global(em) { font-style:italic;color:var(--gold); }
  .ct-text > :global(p) { color:rgba(255,255,255,.5);font-size:.98rem;line-height:1.8; }
  .ct-right { display:flex;flex-direction:column;gap:1rem; }
  .ct-ch { display:flex;align-items:center;gap:1.4rem;padding:1.4rem 1.8rem;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--rl);transition:all var(--t); }
  .ct-ch:hover { background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.15);transform:translateX(6px); }
  .ct-ico { width:50px;height:50px;border-radius:var(--r);display:flex;align-items:center;justify-content:center;flex-shrink:0; }
  .ct-ico svg { width:22px;color:var(--white); }
  .ct-ico-wa   { background:rgba(37,211,102,.2);border:1px solid rgba(37,211,102,.3); }
  .ct-ico-mail { background:rgba(61,111,212,.2);border:1px solid rgba(61,111,212,.3); }
  .ct-lbl { font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.35); }
  .ct-val { font-size:.98rem;color:var(--white);margin-top:.2rem; }
  .ct-ctas { display:flex;flex-direction:column;gap:.8rem;margin-top:.5rem; }

  @media (max-width: 900px) {
    .ct-layout { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
