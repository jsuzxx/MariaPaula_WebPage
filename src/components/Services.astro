---
// Sección de servicios jurídicos: 4 áreas de práctica con CTA a WhatsApp.
import { waLink } from '../data/site';
---

<section id="servicios" aria-label="Servicios jurídicos">
  <div class="sg-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="sv-top">
      <div>
        <div class="eyebrow rv" style="margin-bottom:1rem">
          <div class="eline" style="background:rgba(201,169,110,.6)"></div>
          <span class="etxt" style="color:rgba(201,169,110,.8)">Servicios</span>
        </div>
        <h2 class="rv d1">Servicios jurídicos<br /><em>a su medida</em></h2>
      </div>
      <p class="rv d1">Orientación y representación legal con enfoque en sus necesidades y resultados concretos.</p>
    </div>
    <div class="sv-grid rv d2">
      <article class="sv-item">
        <div class="sv-num">01</div>
        <div class="sv-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg></div>
        <h3>Asesorías Jurídicas</h3>
        <p>Orientación legal personalizada para conocer sus derechos, entender su situación y tomar decisiones informadas antes de iniciar cualquier proceso.</p>
        <a href={waLink('Hola, quisiera una asesoría jurídica.')} class="sv-link" target="_blank" rel="noopener noreferrer">Consultar →</a>
      </article>
      <article class="sv-item">
        <div class="sv-num">02</div>
        <div class="sv-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/></svg></div>
        <h3>Acompañamientos Legales</h3>
        <p>Presencia y representación a su lado durante diligencias, audiencias y trámites para que usted no enfrente solo ningún proceso legal.</p>
        <a href={waLink('Hola, necesito acompañamiento legal.')} class="sv-link" target="_blank" rel="noopener noreferrer">Consultar →</a>
      </article>
      <article class="sv-item">
        <div class="sv-num">03</div>
        <div class="sv-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg></div>
        <h3>Presentación de Demandas</h3>
        <p>Redacción, elaboración y radicación de demandas ante las autoridades competentes, con argumentos sólidos y documentación en orden.</p>
        <a href={waLink('Hola, necesito presentar una demanda.')} class="sv-link" target="_blank" rel="noopener noreferrer">Consultar →</a>
      </article>
      <article class="sv-item">
        <div class="sv-num">04</div>
        <div class="sv-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg></div>
        <h3>Acción de Tutela</h3>
        <p>Mecanismo constitucional para proteger sus derechos fundamentales de forma rápida y eficaz cuando han sido vulnerados o están en riesgo.</p>
        <a href={waLink('Hola, necesito interponer una tutela.')} class="sv-link" target="_blank" rel="noopener noreferrer">Consultar →</a>
      </article>
    </div>
  </div>
</section>

<style>
  #servicios { padding:7rem 0;background:var(--navy);position:relative;overflow:hidden; }
  #servicios::before { content:'';position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none; }
  .sg-glow { position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:800px;height:400px;background:radial-gradient(ellipse,rgba(61,111,212,.12) 0%,transparent 65%);pointer-events:none; }
  .sv-top { display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:4rem;flex-wrap:wrap;gap:2rem;position:relative;z-index:1; }
  .sv-top h2 { font-family:var(--fd);font-size:clamp(2rem,4vw,3.2rem);color:var(--white);font-weight:400;line-height:1.2; }
  .sv-top h2 :global(em) { font-style:italic;color:var(--gold); }
  .sv-top :global(p) { max-width:380px;color:rgba(255,255,255,.45);font-size:.95rem; }
  .sv-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:1.5px;background:rgba(255,255,255,.06);border-radius:var(--rxl);overflow:hidden;position:relative;z-index:1; }
  .sv-item { background:rgba(8,23,46,.85);padding:2.5rem 2rem;display:flex;flex-direction:column;transition:all var(--t);position:relative;overflow:hidden; }
  .sv-item::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(61,111,212,.08) 0%,transparent 60%);opacity:0;transition:opacity var(--t); }
  .sv-item:hover { background:rgba(17,34,68,.97); }
  .sv-item:hover::before { opacity:1; }
  .sv-num { font-family:var(--fd);font-size:.75rem;color:var(--gold);letter-spacing:.15em;margin-bottom:2rem;opacity:.7; }
  .sv-icon { width:52px;height:52px;border-radius:var(--r);background:rgba(61,111,212,.12);border:1px solid rgba(61,111,212,.2);display:flex;align-items:center;justify-content:center;margin-bottom:1.8rem;transition:all var(--t); }
  .sv-item:hover .sv-icon { background:rgba(61,111,212,.25);border-color:rgba(61,111,212,.5); }
  .sv-icon svg { width:24px;height:24px;color:var(--accent); }
  .sv-item h3 { font-family:var(--fd);font-size:1.25rem;color:var(--white);font-weight:500;margin-bottom:1rem;line-height:1.25; }
  .sv-item :global(p) { font-size:.88rem;color:rgba(255,255,255,.45);line-height:1.7;flex:1; }
  .sv-link { margin-top:2rem;display:inline-flex;align-items:center;gap:.4rem;font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);transition:gap var(--t); }
  .sv-item:hover .sv-link { gap:.8rem; }

  @media (max-width: 900px) {
    .sv-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 768px) {
    .sv-grid { grid-template-columns: 1fr; }
  }
</style>
