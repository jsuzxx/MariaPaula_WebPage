---
// Tarjetas de artículos del blog. Se usa en la home (3 últimos)
// y en el listado /blog y en artículos (relacionados).
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
  variant?: 'home' | 'uniform';
  title?: string;
  subtitle?: string;
  showCta?: boolean;
}

const { posts, variant = 'home', title, subtitle, showCta = false } = Astro.props;

const fmt = new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric' });

// Icono según categoría
const icons: Record<string, string> = {
  fundamentales:
    'M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971z',
  familia:
    'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  contratos:
    'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  laboral:
    'M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z',
  sucesiones:
    'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
};
const defaultIcon =
  'M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971z';

function iconFor(category: string): string {
  const key = Object.keys(icons).find((k) => category.toLowerCase().includes(k));
  return key ? icons[key] : defaultIcon;
}
---

<section id="blog" aria-label="Blog jurídico" class="blog-section">
  <div class="container">
    <div class="bl-top">
      <div>
        <div class="eyebrow rv" style="margin-bottom:1rem">
          <div class="eline"></div><span class="etxt">Blog jurídico</span>
        </div>
        <h2 class="rv d1">{title ?? <>Información legal<br /><em>para todos</em></>}</h2>
        {subtitle && <p class="rv d1">{subtitle}</p>}
      </div>
      {
        showCta && (
          <a href="/blog" class="btn btn-navy rv d1">
            Ver todos →
          </a>
        )
      }
    </div>
    <div class={`bl-grid rv d2 ${variant === 'uniform' ? 'uniform' : ''}`}>
      {
        posts.map((post, i) => (
          <article class="bl-card">
            <a href={`/blog/${post.id}/`} aria-label={post.data.title}>
              <div class="bl-img">
                <div class={`bl-bg bl-bg${(i % 5) + 1}`} />
                <div class="bl-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width=".75">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconFor(post.data.category)} />
                  </svg>
                </div>
                <span class="bl-tag">{post.data.category}</span>
              </div>
              <div class="bl-body">
                <div class="bl-meta">
                  {fmt.format(post.data.pubDate)}
                  <span class="bl-dot" />{post.data.minutesRead} min de lectura
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="bl-cta">Leer artículo →</span>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  #blog { padding: 7rem 0; background: var(--off-white); }
  .bl-top { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3.5rem; flex-wrap: wrap; gap: 1.5rem; }
  .bl-top h2 { font-family: var(--fd); font-size: clamp(2rem, 3.5vw, 2.8rem); color: var(--navy); font-weight: 400; }
  .bl-top h2 :global(em) { font-style: italic; color: var(--accent); }
  /* La tarjeta es un enlace completo */
  .bl-card :global(a) { display: flex; flex-direction: column; height: 100%; color: inherit; }
</style>
